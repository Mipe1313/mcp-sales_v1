# Azure AD / Entra ID – App Registration
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret-here

# Dataverse environment URL (no trailing slash)
# e.g. https://orgname.crm4.dynamics.com
ENVIRONMENT_URL=https://orgname.crm4.dynamics.com

# HTTP server port (leave empty or set TRANSPORT=stdio for stdio mode)
PORT=3000

# Transport mode: "http" (default, for Copilot Studio) or "stdio" (local dev)
TRANSPORT=http
