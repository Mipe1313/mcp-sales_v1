{
  "name": "dataverse-mcp-server",
  "version": "1.0.61",
  "description": "MCP server for Copilot Studio – Dataverse account form customisation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const [maj,min,pat]=p.version.split('.').map(Number);p.version=maj+'.'+min+'.'+(pat+1);fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n');console.log('[build] version →',p.version);\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.6.3"
  }
}
